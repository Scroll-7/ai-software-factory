{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "code.v1",
  "title": "Sortie de l'agent Code",
  "type": "object",
  "additionalProperties": false,
  "required": ["files", "selfCheck", "notes"],
  "properties": {
    "files": {
      "type": "array", "minItems": 1, "maxItems": 3,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "mode", "content", "requirementIds", "explanation"],
        "properties": {
          "path": { "type": "string" },
          "mode": { "enum": ["FULL_FILE", "UNIFIED_DIFF"] },
          "content": { "type": "string", "maxLength": 20000 },
          "requirementIds": { "type": "array", "minItems": 1, "items": { "pattern": "^R[0-9]+$" } },
          "explanation": { "type": "string", "maxLength": 300 }
        }
      }
    },
    "selfCheck": {
      "type": "object", "additionalProperties": false,
      "required": ["noExternalCalls", "noSecrets", "usesExistingFramework", "pathsExist", "noUnsafeApi"],
      "properties": {
        "noExternalCalls": { "type": "boolean" },
        "noSecrets": { "type": "boolean" },
        "usesExistingFramework": { "type": "boolean" },
        "pathsExist": { "type": "boolean" },
        "noUnsafeApi": { "type": "boolean" }
      }
    },
    "notes": { "type": "string", "maxLength": 400 }
  }
}
