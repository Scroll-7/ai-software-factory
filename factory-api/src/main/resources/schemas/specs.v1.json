{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "specs.v1",
  "title": "Sortie de l'agent Specs",
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "language", "requirements", "openQuestions", "citations"],
  "properties": {
    "summary": { "type": "string", "minLength": 20, "maxLength": 600 },
    "language": { "const": "fr" },
    "requirements": {
      "type": "array", "minItems": 1, "maxItems": 8,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "text", "acceptanceCriteria", "sourceUris", "priority"],
        "properties": {
          "id": { "type": "string", "pattern": "^R[0-9]+$" },
          "text": { "type": "string", "minLength": 10, "maxLength": 300 },
          "acceptanceCriteria": {
            "type": "array", "minItems": 1, "maxItems": 5,
            "items": { "type": "string", "minLength": 5 }
          },
          "sourceUris": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "priority": { "enum": ["MUST", "SHOULD"] }
        }
      }
    },
    "openQuestions": { "type": "array", "items": { "type": "string" } },
    "citations": { "type": "array", "items": { "type": "string" } }
  }
}
